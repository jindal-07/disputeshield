# PayPal sandbox app (developer.paypal.com → Apps & Credentials → Sandbox → your app)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENV=sandbox

# Optional: webhook id from the same app page (Webhooks → Add webhook → CUSTOMER.DISPUTE.*)
# URL: https://<your-host>/api/webhooks/paypal
PAYPAL_WEBHOOK_ID=

# Claude (console.anthropic.com → API keys)
ANTHROPIC_API_KEY=
# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=medium
# CLAUDE_FALLBACKS=off

# Optional business settings
# SELLER_MAX_REFUND_PCT=60
# DISPUTE_FEE_USD=15
